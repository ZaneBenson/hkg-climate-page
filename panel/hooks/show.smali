    # hkg-climate-page hook (GPL-3.0): aS(I) case 4 returns our page instead of the stock climate view
    # hkg-climate-page: id 4 shows our page (null when it failed to load)
    iget-object v0, p0, Lcom/mobis/splitscreen/right/SplitScreenHome;->hkgClimatePage:Lcom/mobis/splitscreen/right/k;
    goto :goto_2d
